<%- include('./partials/header') %>
<style>
    .admin-wrap{
        margin-top:56px;border-top:1px solid var(--border);
        display:flex;min-height:calc(100vh - 56px);
    }
    .admin-sidebar{
        width:200px;flex-shrink:0;
        border-right:1px solid var(--border);
        padding:2rem 1.5rem;
    }
    .admin-sidebar-link{
        display:block;font-size:0.78rem;letter-spacing:0.1em;text-transform:uppercase;
        color:var(--text);text-decoration:none;padding:10px 0;
        border-bottom:1px solid var(--border);transition:color 0.2s,padding-left 0.2s;
    }
    .admin-sidebar-link:hover{color:var(--accent);padding-left:6px;}
    .admin-main{flex:1;padding:3rem;}
    .admin-title{
        font-family:'Bebas Neue',sans-serif;font-size:3rem;
        margin-bottom:2.5rem;border-bottom:1px solid var(--border);padding-bottom:1rem;
    }
    .form-section{margin-bottom:2.5rem;}
    .form-section-label{
        font-size:0.68rem;letter-spacing:0.2em;text-transform:uppercase;
        color:var(--text2);margin-bottom:1.2rem;
    }
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;}
    .form-field{
        width:100%;padding:10px 0;
        background:transparent;border:none;
        border-bottom:1px solid var(--border);
        color:var(--text);font-family:'DM Sans',sans-serif;
        font-size:0.88rem;outline:none;
        transition:border-color 0.3s;cursor:none;
    }
    .form-field::placeholder{color:var(--text2);font-size:0.8rem;}
    .form-field:focus{border-bottom-color:var(--accent);}
    input[type="file"].form-field{padding:8px 0;cursor:none;}
    .submit-btn{
        display:inline-flex;align-items:center;gap:10px;
        padding:12px 32px;
        background:var(--btn);color:var(--btn-text);
        border:1px solid var(--border);
        font-size:0.75rem;font-weight:500;letter-spacing:0.14em;
        text-transform:uppercase;cursor:none;margin-top:1rem;
        transition:background 0.3s,color 0.3s,transform 0.2s;
    }
    .submit-btn:hover{background:var(--accent);border-color:var(--accent);color:#fff;transform:translateX(4px);}
    .success-toast{
        position:fixed;top:68px;left:50%;transform:translateX(-50%);
        background:var(--accent);color:#fff;
        padding:10px 28px;font-size:0.75rem;letter-spacing:0.12em;text-transform:uppercase;
        border:1px solid var(--border);z-index:500;
        animation:flashIn 0.4s ease,flashOut 0.4s ease 2.6s forwards;
    }
    @keyframes flashIn{from{opacity:0;top:60px}to{opacity:1;top:68px}}
    @keyframes flashOut{from{opacity:1}to{opacity:0}}
</style>

<% if(success && success.length>0){ %>
    <div class="success-toast"><%= success %></div>
<% } %>

<div class="admin-wrap page-content">
    <aside class="admin-sidebar">
        <a class="admin-sidebar-link" href="/owners/admin">Create Product</a>
        <a class="admin-sidebar-link" href="/shop">View Shop</a>
        <a class="admin-sidebar-link" href="/users/logout">Exit</a>
    </aside>

    <main class="admin-main">
        <div class="admin-title">New Product</div>
        <form autocomplete="off" action="/products/create" method="post" enctype="multipart/form-data">

            <div class="form-section">
                <div class="form-section-label">Product Details</div>
                <div style="margin-bottom:1.2rem;">
                    <input class="form-field" name="image" type="file" accept="image/*" required>
                </div>
                <div class="form-grid">
                    <input class="form-field" name="name" type="text" placeholder="Product Name" required>
                    <input class="form-field" name="price" type="number" placeholder="Price (₹)" required>
                    <input class="form-field" name="discount" type="number" placeholder="Discount (₹)" value="0">
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-label">Panel Colors</div>
                <div class="form-grid">
                    <input class="form-field" name="bgcolor" type="text" placeholder="Background Color (e.g. #f0f0f0)">
                    <input class="form-field" name="panelcolor" type="text" placeholder="Panel Color (e.g. #ffffff)">
                    <input class="form-field" name="textcolor" type="text" placeholder="Text Color (e.g. #000000)">
                </div>
            </div>

            <button class="submit-btn" type="submit">
                Create Product <i class="ri-add-line"></i>
            </button>
        </form>
    </main>
</div>

<%- include('./partials/footer') %>
