<%- include('./partials/header') %>
<style>
    .split-panel{
        min-height:100vh;display:flex;
        border-top:1px solid var(--border);margin-top:56px;
    }
    .panel{
        flex:1;display:flex;align-items:center;justify-content:center;
        padding:4rem 5rem;position:relative;
        border-right:1px solid var(--border);overflow:hidden;
    }
    .panel:last-child{border-right:none;}
    .panel-label{
        position:absolute;top:2rem;left:2rem;
        font-size:0.65rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--text2);
    }
    .panel-num{
        position:absolute;bottom:2rem;right:2rem;
        font-family:'Bebas Neue',sans-serif;font-size:6rem;
        color:var(--border);opacity:0.06;line-height:1;pointer-events:none;
    }
    .form-title{
        font-family:'Bebas Neue',sans-serif;font-size:clamp(2.5rem,5vw,3.8rem);
        line-height:1;margin-bottom:0.3rem;color:var(--text);
    }
    .form-sub{font-size:0.78rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--text2);margin-bottom:2rem;}
    .form-inner{width:100%;max-width:340px;}
    .field{
        width:100%;padding:12px 0;background:transparent;border:none;
        border-bottom:1px solid var(--border);color:var(--text);
        font-family:'DM Sans',sans-serif;font-size:0.9rem;outline:none;margin-bottom:1.2rem;
        transition:border-color 0.3s;cursor:none;
    }
    .field::placeholder{color:var(--text2);font-size:0.82rem;letter-spacing:0.06em;}
    .field:focus{border-bottom-color:var(--accent);}
    .submit-btn{
        display:inline-flex;align-items:center;gap:10px;
        padding:12px 28px;background:var(--btn);color:var(--btn-text);
        border:1px solid var(--border);font-size:0.75rem;font-weight:500;
        letter-spacing:0.14em;text-transform:uppercase;cursor:none;margin-top:0.5rem;
        transition:background 0.3s,color 0.3s,transform 0.2s;
    }
    .submit-btn:hover{background:var(--accent);border-color:var(--accent);color:#fff;transform:translateX(4px);}
    .inline-error{
        font-size:0.72rem;letter-spacing:0.08em;text-transform:uppercase;
        color:var(--accent);margin-bottom:1rem;display:none;
        border-left:2px solid var(--accent);padding-left:8px;
    }
    .inline-error.show{display:block;}
</style>

<% if(error && error.length>0){ %>
    <div class="flash-msg"><%= error %></div>
<% } %>
<% if(typeof success !== 'undefined' && success && success.length>0){ %>
    <div class="flash-msg" style="background:var(--btn);"><%= success %></div>
<% } %>

<div class="split-panel page-content">
    <!-- Register -->
    <div class="panel">
        <span class="panel-label">New here</span>
        <span class="panel-num">01</span>
        <div class="form-inner">
            <h2 class="form-title">Create<br>Account</h2>
            <p class="form-sub">Join Scatch today</p>
            <div class="inline-error" id="reg-err"></div>
            <form autocomplete="off" action="/users/register" method="post" onsubmit="return validateRegister(this)">
                <input class="field" type="text" placeholder="Full Name" name="fullname">
                <input class="field" type="email" placeholder="Email Address" name="email">
                <input class="field" type="password" placeholder="Password (min 6 chars)" name="password">
                <button class="submit-btn" type="submit">
                    Register <i class="ri-arrow-right-line"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- Login -->
    <div class="panel">
        <span class="panel-label">Welcome back</span>
        <span class="panel-num">02</span>
        <div class="form-inner">
            <h2 class="form-title">Sign<br>In</h2>
            <p class="form-sub">Access your account</p>
            <div class="inline-error" id="login-err"></div>
            <form autocomplete="off" action="/users/login" method="post" onsubmit="return validateLogin(this)">
                <input class="field" type="email" placeholder="Email Address" name="email">
                <input class="field" type="password" placeholder="Password" name="password">
                <button class="submit-btn" type="submit">
                    Login <i class="ri-arrow-right-line"></i>
                </button>
            </form>
            <button onclick="toggleAdmin()" style="margin-top:2rem;background:none;border:none;font-size:0.62rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--text2);cursor:none;padding:0;text-decoration:underline;text-underline-offset:3px;">
                Admin Access
            </button>
        </div>
    </div>
</div>

<!-- Admin Login Drawer -->
<div id="admin-drawer" style="display:none;border-top:1px solid var(--border);padding:3rem 5rem;background:var(--bg2);">
    <div style="max-width:340px;margin:0 auto;">
        <h2 class="form-title" style="font-family:'Bebas Neue',sans-serif;font-size:2rem;margin-bottom:0.3rem;">Admin<br>Access</h2>
        <p style="font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--text2);margin-bottom:1.5rem;">Restricted — Owners only</p>
        <div class="inline-error" id="admin-err"></div>
        <form autocomplete="off" action="/owners/login" method="post" onsubmit="return validateAdmin(this)">
            <input class="field" type="email" placeholder="Owner Email" name="email">
            <input class="field" type="password" placeholder="Owner Password" name="password">
            <button class="submit-btn" type="submit">
                Enter Panel <i class="ri-arrow-right-line"></i>
            </button>
        </form>
    </div>
</div>

<script>
function validateRegister(f){
    const name=f.fullname.value.trim();
    const email=f.email.value.trim();
    const pass=f.password.value.trim();
    const err=document.getElementById('reg-err');
    if(!name){return showInline(err,'Full name is required');}
    if(!email||!email.includes('@')){return showInline(err,'Valid email is required');}
    if(!pass||pass.length<6){return showInline(err,'Password must be at least 6 characters');}
    return true;
}
function validateLogin(f){
    const email=f.email.value.trim();
    const pass=f.password.value.trim();
    const err=document.getElementById('login-err');
    if(!email){return showInline(err,'Email is required');}
    if(!pass){return showInline(err,'Password is required');}
    return true;
}
function showInline(el,msg){
    el.textContent=msg;el.classList.add('show');
    setTimeout(()=>el.classList.remove('show'),3000);
    return false;
}
function toggleAdmin(){
    const d=document.getElementById('admin-drawer');
    d.style.display=d.style.display==='none'?'block':'none';
    if(d.style.display==='block') d.scrollIntoView({behavior:'smooth'});
}
function validateAdmin(f){
    const email=f.email.value.trim();
    const pass=f.password.value.trim();
    const err=document.getElementById('admin-err');
    if(!email||!pass){return showInline(err,'Email and password required');}
    return true;
}
</script>

<%- include('./partials/footer') %>
